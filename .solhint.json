{
  "extends": "solhint:recommended",
  "plugins": [],
  "rules": {
    "compiler-version": ["error", "^0.8.20"],
    "func-visibility": ["error", { "ignoreConstructors": true }],
    "avoid-sha3": "warn",
    "no-empty-blocks": "off",
    "reason-string": "off",
    "code-complexity": ["warn", 10],
    "max-line-length": ["warn", 160]
  }
}

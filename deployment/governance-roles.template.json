{
  "network": {
    "name": "sepolia",
    "chainId": 11155111,
    "deploymentEnvironment": "testnet"
  },
  "roles": {
    "councilSafe": {
      "address": "<3_of_5_safe_address>",
      "threshold": 3,
      "owners": [
        "<council_owner_1>",
        "<council_owner_2>",
        "<council_owner_3>",
        "<council_owner_4>",
        "<council_owner_5>"
      ]
    },
    "rootConfirmer": "<separate_root_confirmer_address>",

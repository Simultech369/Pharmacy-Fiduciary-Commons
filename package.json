{
  "name": "pbmrebatetreasuryfinal",
  "version": "1.0.0",
  "description": "Anti-extractive fiduciary commons prototype reclaiming captured pharmaceutical rebate surplus for independent community pharmacies and patient-governed funds (unaudited).",
  "main": "index.js",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "test:security": "hardhat test test/PBMRebateTreasury.security.test.js",
    "build:dashboard": "node scripts/build-dashboard.js",
    "check:frontend": "node scripts/check-frontend-build.js",
    "check:deployment-template": "node scripts/validate-deployment-config.js --parameters deployment/parameters.template.json --governance deployment/governance-roles.template.json --allow-placeholders",
    "check:deployment-config": "node scripts/validate-deployment-config.js --parameters deployment/parameters.production.json --governance deployment/governance-roles.production.json",
    "check:release:production": "node scripts/check-production-release.js",
    "deploy:timelock": "hardhat run scripts/deploy-timelock-and-treasury.js",
    "verify:contracts": "hardhat run scripts/verify-contracts.js",
    "verify:export": "node scripts/verify-export.js",
    "demo:local": "node scripts/local-demo.js",
    "eval:rag": "python scripts/eval_dossier_rag.py",
    "check:readiness": "node scripts/check-readiness.js",
    "audit:deployment": "hardhat run scripts/audit-deployment.js",
    "merkle:allocations": "node tools/merkle/allocations.js",
    "dev:server": "node server/server.js",
    "coverage": "hardhat coverage && node scripts/publish_coverage_summary.js",
    "test:fuzz": "hardhat test test/PBMRebateTreasury.fuzz.test.js",
    "test:regressions": "hardhat test test/PBMRebateTreasury.regressions.test.js",
    "test:formal": "hardhat test test/PBMRebateFormalInvariants.test.js test/PBMFraudFormalInvariants.test.js",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "audit:slither": "python3 scripts/check_slither_ci.py",
    "audit:deps": "npm audit --audit-level=high"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "4.9.6",
    "chai": "^6.2.2",
    "ethers": "^6.17.0",
    "hardhat": "^2.22.16",
    "solhint": "^5.0.5",
    "solidity-coverage": "^0.8.17",
    "supertest": "^7.2.2"
  },
  "volta": {
    "node": "22.23.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "overrides": {
    "serialize-javascript": "^7.1.3",
    "tmp": "^0.2.6"
  }
}

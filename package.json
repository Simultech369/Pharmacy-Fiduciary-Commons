{
  "name": "pbmrebatetreasuryfinal",
  "version": "1.0.0",
  "description": "**On-chain rebate transparency for independent pharmacies and patients.**",
  "main": "index.js",
  "engines": {
    "node": "20.x || 22.x"
  },
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "test:security": "hardhat test test/PBMRebateTreasury.security.test.js",
    "build:dashboard": "node scripts/build-dashboard.js",
    "check:frontend": "node scripts/check-frontend-build.js",
    "check:deployment-template": "node scripts/validate-deployment-config.js --parameters deployment/parameters.template.json --governance deployment/governance-roles.template.json --allow-placeholders",
    "check:deployment-config": "node scripts/validate-deployment-config.js --parameters deployment/parameters.production.json --governance deployment/governance-roles.production.json",
    "check:release:production": "node scripts/check-production-release.js",
    "deploy:timelock": "hardhat run scripts/deploy-timelock-and-treasury.js",
    "verify:contracts": "hardhat run scripts/verify-contracts.js",
    "verify:export": "node scripts/verify-export.js",
    "check:readiness": "node scripts/check-readiness.js",
    "audit:deployment": "hardhat run scripts/audit-deployment.js",
    "merkle:allocations": "node tools/merkle/allocations.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^4.9.6",
    "chai": "^6.2.2",
    "ethers": "^6.16.0",
    "hardhat": "^2.22.16",
    "supertest": "^7.2.2"
  },
  "volta": {
    "node": "22.23.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
}

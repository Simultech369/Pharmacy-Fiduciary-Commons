    },
    {
      "from": "rehearsal_gate",
      "to": "failure_memory",
      "relationship": "EVALUATES_PROPOSALS_AGAINST_MEMORIES",
      "verification_cmd": "npx hardhat test test/rehearse_proposal.test.js"
    },
    {
      "from": "dossier_auditor",
      "to": "treasury_core",
      "relationship": "INDEXES_PROOF_BOUNDARIES",

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FuturePublicZKPayload",
  "type": "object",
  "properties": {
    "privacyTarget": {
      "type": "string",
      "enum": ["unlinkable", "semantic-wallet-linkable"]
    },
    "domain": {
      "type": "string"
    },
    "scopeId": {
      "type": "string"
    },
    "nullifier": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "membershipRoot": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "verifierVersion": {
      "type": "string"
    },
    "circuitId": {
      "type": "string"
    },
    "publicSignals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadataLeakageBudget": {
      "type": "object",
      "properties": {
        "allowsWalletAddress": { "type": "boolean" },
        "allowsStableHash": { "type": "boolean" },
        "allowsExactTimestamp": { "type": "boolean" },
        "allowsNpiOrNcpdp": { "type": "boolean" }
      },
      "required": [
        "allowsWalletAddress",
        "allowsStableHash",
        "allowsExactTimestamp",
        "allowsNpiOrNcpdp"
      ]
    }
  },
  "required": [
    "privacyTarget",
    "domain",
    "scopeId",
    "nullifier",
    "membershipRoot",
    "verifierVersion",
    "circuitId",
    "publicSignals",
    "metadataLeakageBudget"
  ]
}
